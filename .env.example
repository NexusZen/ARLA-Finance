# ==============================================================================
# Redis Configuration (Supports both Redis Cloud and Upstash Redis)
# ==============================================================================

# Option 1: Official Redis Cloud on Vercel (Auto-injected by Vercel Redis Integration)
# REDIS_URL=redis://default:your_password@your_host:your_port

# Option 2: Upstash Redis (or Vercel KV)
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
