# ==============================================================================
# Upstash Redis / Vercel KV Configuration
# ==============================================================================
# When deploying to Vercel, connect Upstash Redis via the Vercel dashboard:
# Project -> Storage -> Create Database -> KV or Upstash Redis
# Vercel will automatically inject these environment variables.
#
# Alternatively, create a free database at https://upstash.com and paste the credentials below:

UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# (Vercel KV aliases are also automatically supported):
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
